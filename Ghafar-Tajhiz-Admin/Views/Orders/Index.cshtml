@using DataAccess.Enums
@model List<BusinessLogic.BasketServices.Models.AdminOrderDto>

@{
    ViewData["Title"] = "سفارش‌ها";
}

<div class="page-header">

    <h1>
        مدیریت سفارش‌ها
    </h1>

    <p>
        بررسی وضعیت سفارش‌های ثبت‌شده
    </p>

</div>


<!-- =========================================================
     Search / Filter
     ========================================================= -->

<div class="admin-card" style="margin-bottom:15px;">

    <form method="get"
          class="form-row">

        <input name="search"
               value="@ViewBag.Search"
               class="form-input"
               placeholder="جستجو نام، موبایل، آدرس، محصول..." />


        <select name="status"
                class="form-select">

            <option value="">
                همه وضعیت‌ها
            </option>

            <option value="PendingPayment"
                    selected="@(ViewBag.Status == BasketStatus.PendingPayment ? "selected" : null)">
                در انتظار پرداخت
            </option>

            <option value="AwaitingPaymentVerification"
                    selected="@(ViewBag.Status == BasketStatus.AwaitingPaymentVerification ? "selected" : null)">
                در انتظار بررسی پرداخت
            </option>

            <option value="PaymentApproved"
                    selected="@(ViewBag.Status == BasketStatus.PaymentApproved ? "selected" : null)">
                پرداخت تأیید شد
            </option>

            <option value="PaymentRejected"
                    selected="@(ViewBag.Status == BasketStatus.PaymentRejected ? "selected" : null)">
                پرداخت رد شد
            </option>

            <option value="Shipped"
                    selected="@(ViewBag.Status == BasketStatus.Shipped ? "selected" : null)">
                ارسال شده
            </option>

            <option value="Cancelled"
                    selected="@(ViewBag.Status == BasketStatus.Cancelled ? "selected" : null)">
                لغو شده
            </option>

        </select>


        <select name="sort"
                class="form-select">

            <option value="paiddate"
                    selected="@(ViewBag.Sort == "paiddate" ? "selected" : null)">
                جدیدترین
            </option>

            <option value="oldest"
                    selected="@(ViewBag.Sort == "oldest" ? "selected" : null)">
                قدیمی‌ترین
            </option>

            <option value="status"
                    selected="@(ViewBag.Sort == "status" ? "selected" : null)">
                بر اساس وضعیت
            </option>

        </select>


        <button type="submit"
                class="form-button">
            جستجو
        </button>

    </form>

</div>


<!-- Anti Forgery -->

<form id="stateForm">

    @Html.AntiForgeryToken()

</form>


<!-- =========================================================
     Orders Table
     ========================================================= -->

<div class="admin-card">

    @if (!Model.Any())
    {
        <div class="empty-state">
            سفارشی پیدا نشد.
        </div>
    }
    else
    {
        <div class="table-scroll">

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>
                            نام
                        </th>

                        <th>
                            شماره تماس
                        </th>

                        <th>
                            تاریخ پرداخت
                        </th>

                        <th>
                            محصولات
                        </th>


                        <th>
                            وضعیت
                        </th>

                        <th>
                            عملیات
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- User -->

                            <td>
                                @item.UserName
                            </td>


                            <!-- Mobile -->

                            <td>
                                @item.MobileNumber
                            </td>


                            <!-- Paid Date -->

                            <td>

                                @if (item.PaidDate.HasValue)
                                {
                                    @item.PaidDate.Value.ToString(
                                             "yyyy/MM/dd HH:mm")
                                }
                                else
                                {
                                    <span>
                                        -
                                    </span>
                                }

                            </td>


                            <!-- Products -->

                            <td>

                                @if (item.Items != null &&
                               item.Items.Any())
                                {
                                    @string.Join(" + ", item.Items)
                                }
                                else
                                {
                                    <span>
                                        -
                                    </span>
                                }

                            </td>


                          

                            <!-- Status -->

                            <td>

                                @switch (item.Status)
                                {
                                    case BasketStatus.PendingPayment:

                                        <span class="badge badge-warning">
                                            در انتظار پرداخت
                                        </span>

                                        break;


                                    case BasketStatus.AwaitingPaymentVerification:

                                        <span class="badge badge-warning">
                                            در انتظار بررسی پرداخت
                                        </span>

                                        break;


                                    case BasketStatus.PaymentApproved:

                                        <span class="badge badge-success">
                                            پرداخت تأیید شد
                                        </span>

                                        break;


                                    case BasketStatus.PaymentRejected:

                                        <span class="badge badge-danger">
                                            پرداخت رد شد
                                        </span>

                                        break;


                                    case BasketStatus.Shipped:

                                        <span class="badge badge-success">
                                            ارسال شده
                                        </span>

                                        break;


                                    case BasketStatus.Cancelled:

                                        <span class="badge badge-danger">
                                            لغو شده
                                        </span>

                                        break;


                                    default:

                                        <span class="badge">
                                            نامشخص
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- Actions -->

                            <td>

                                <div class="action-group">

                                    <!-- مشاهده جزئیات -->

                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@item.AdminOrderId"
                                       class="action-btn action-view"
                                       title="مشاهده جزئیات">

                                        <i class="fa fa-eye"></i>

                                    </a>


                                    <!-- تأیید / رد پرداخت -->
                                    @if (item.Status ==
                                   BasketStatus.AwaitingPaymentVerification)
                                    {
                                        <button type="button"
                                                onclick="State(@item.AdminOrderId, true)"
                                                class="action-btn action-accept"
                                                title="تأیید پرداخت">

                                            <i class="fa fa-check"></i>

                                        </button>


                                        <button type="button"
                                                onclick="State(@item.AdminOrderId, false)"
                                                class="action-btn action-cancel"
                                                title="رد پرداخت">

                                            <i class="fa fa-times"></i>

                                        </button>
                                    }


                                    <!-- ارسال سفارش -->
                                    @if (item.Status ==
                                   BasketStatus.PaymentApproved)
                                    {
                                        <button type="button"
                                                onclick="ShipOrder(@item.AdminOrderId)"
                                                class="action-btn action-accept"
                                                title="ارسال سفارش">

                                            <i class="fa fa-truck"></i>

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>


                        <!-- =================================================
                             Rejection Reason
                             ================================================= -->
                        @if (item.Status ==
                       BasketStatus.PaymentRejected &&
                       !string.IsNullOrWhiteSpace(
                       item.PaymentRejectionReason))
                        {
                            <tr>

                                <td colspan="7">

                                    <div class="alert alert-danger"
                                         style="margin:0;">

                                        <strong>
                                            دلیل رد پرداخت:
                                        </strong>

                                        @item.PaymentRejectionReason

                                    </div>

                                </td>

                            </tr>
                        }

                    }

                </tbody>

            </table>

        </div>
    }

</div>