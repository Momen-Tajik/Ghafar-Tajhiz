<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] | پنل مدیریت
    </title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />


    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />


    @await RenderSectionAsync("Styles", required: false)

</head>


<body class="admin-body">


    <header class="admin-navbar">

        <div class="title">
            پنل مدیریت Ghafar Tajhiz
        </div>


        <form asp-controller="AdminAccount"
              asp-action="Logout"
              method="post"
              style="display:inline;">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="logout">

                خروج

            </button>

        </form>

    </header>


    <div class="admin-container">


        <aside class="admin-sidebar">

            <ul>

                <li>

                    <a asp-controller="Home"
                       asp-action="Index">

                        <i class="fa fa-dashboard"></i>

                        داشبورد

                    </a>

                </li>


                <li>

                    <a asp-controller="Categories"
                       asp-action="Index">

                        <i class="fa fa-list"></i>

                        دسته‌بندی‌ها

                    </a>

                </li>


                <li>

                    <a asp-controller="Products"
                       asp-action="Index">

                        <i class="fa fa-cube"></i>

                        محصولات

                    </a>

                </li>


                <li>

                    <a asp-controller="Orders"
                       asp-action="Index">

                        <i class="fa fa-shopping-cart"></i>

                        سفارش‌ها

                    </a>

                </li>


                <li>

                    <a asp-controller="AdminUser"
                       asp-action="Index">

                        <i class="fa fa-users"></i>

                        کاربران

                    </a>

                </li>

            </ul>

        </aside>


        <main class="admin-content">

            @RenderBody()

        </main>

    </div>


    <footer class="admin-footer">

        © ۱۴۰۴ - Ghafar Tajhiz

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>


    <script src="~/js/admin.js"
            asp-append-version="true"></script>


    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>


    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>


    @{
        var successMessage =
        TempData["Success"] as string;

        var errorMessage =
        TempData["Error"] as string;
    }


    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <script>

            showSuccessToast(
            @Html.Raw(
                     System.Text.Json.JsonSerializer.Serialize(
                     successMessage
                     )
                     )
                        );

        </script>
    }


    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <script>

            showErrorToast(
            @Html.Raw(
                     System.Text.Json.JsonSerializer.Serialize(
                     errorMessage
                     )
                     )
                        );

        </script>
    }


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>