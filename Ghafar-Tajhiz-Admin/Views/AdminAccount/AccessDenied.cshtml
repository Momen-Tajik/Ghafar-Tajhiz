@{
    ViewData["Title"] = "عدم دسترسی";
    Layout = "_AdminAuthLayout";
}

<div class="auth-shell">
    <div class="auth-card state-auth-card">
        <div class="state-icon state-icon-warning">
            <i class="fa fa-lock"></i>
        </div>

        <div class="auth-heading text-center">
            <h1>دسترسی غیرمجاز</h1>
            <p>شما اجازه دسترسی به این بخش را ندارید.</p>
        </div>

        <div class="state-actions">
            <a asp-controller="AdminAccount"
               asp-action="Login"
               class="admin-btn admin-btn-primary">
                <i class="fa fa-sign-in"></i>
                ورود به پنل مدیریت
            </a>
        </div>
    </div>
</div>
