@using DataAccess.Models
@model IReadOnlyList<Product>
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "خرید تجهیزات آشپزخانه صنعتی و رستورانی";
    ViewData["MetaDescription"] = "تجهیزات آشپزخانه صنعتی، رستورانی، فست‌فود و هتلی را در فروشگاه تجهیزات تاجیک بررسی کنید؛ مشخصات محصولات را ببینید و تجهیزات موردنیاز کسب‌وکار خود را انتخاب کنید.";
    ViewData["CanonicalUrl"] = $"{(Configuration["Seo:SiteUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}").TrimEnd('/')}{Context.Request.PathBase}/";
}


<div class="home-page">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="home-hero">

        <div class="home-hero-container">

            <!-- =================================================
                 Hero Content
                 ================================================= -->

            <div class="home-hero-content">

                <span class="home-hero-badge">
                    تجهیزات تاجیک
                </span>


                <h1>
                    آشپزخانه صنعتی‌ات را
                    حرفه‌ای‌تر بساز
                </h1>


                <p>
                    تجهیزات مناسب، یکی از مهم‌ترین بخش‌های
                    یک کسب‌وکار حرفه‌ای است.
                    ما مجموعه‌ای از تجهیزات آشپزخانه صنعتی،
                    رستورانی، فست‌فود و هتلی را برای شما فراهم کرده‌ایم
                    تا انتخاب و تأمین تجهیزات ساده‌تر و مطمئن‌تر باشد.
                </p>


                <div class="home-hero-actions">

                    <a asp-controller="Product"
                       asp-action="ProductList"
                       class="home-primary-btn">

                        مشاهده محصولات

                        <i class="fa fa-arrow-left"></i>

                    </a>

                    <a asp-controller="Home"
                       asp-action="AboutUs"
                       class="home-secondary-btn">

                        درباره ما

                    </a>

                </div>


                <!-- =============================================
                     Trust Features
                     ============================================= -->

                <div class="home-hero-features">

                    <div class="home-feature">

                        <div class="home-feature-icon">
                            <i class="fa fa-check"></i>
                        </div>

                        <span>
                            تجهیزات متنوع
                        </span>

                    </div>


                    <div class="home-feature">

                        <div class="home-feature-icon">
                            <i class="fa fa-headphones"></i>
                        </div>

                        <span>
                            پشتیبانی مشتری
                        </span>

                    </div>


                    <div class="home-feature">

                        <div class="home-feature-icon">
                            <i class="fa fa-handshake-o"></i>
                        </div>

                        <span>
                            خرید مطمئن
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 Hero Image
                 ================================================= -->

            <div class="home-hero-visual">

                <div class="home-hero-image-wrapper">

                    <img class="home-hero-image"
                         src="~/asstes/img/ChatGPT Image Oct 12, 2025, 09_56_41 PM.png"
                         alt="تجهیزات و آشپزخانه صنعتی"
                         width="900"
                         height="650"
                         fetchpriority="high" />

                </div>


                <div class="home-image-badge">

                    <i class="fa fa-star"></i>

                    <div>

                        <strong>
                            تجهیزات حرفه‌ای
                        </strong>

                        <span>
                            برای کسب‌وکار شما
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PRODUCTS
         ===================================================== -->

    <section class="home-products-section">

        @await Component.InvokeAsync("HomeProducts")

    </section>

</div>


@section Scripts {
    <script>
        $(function () {

            if (typeof $.fn.owlCarousel !== "function") {
                console.error("Owl Carousel بارگذاری نشده است. مسیر فایل JS را بررسی کنید.");
                return;
            }

            // مدت نمایش هر اسلاید (میلی‌ثانیه) — هر عددی که می‌خواهید
            var AUTO_SLIDE_MS = 6000;

            var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            var canHover = window.matchMedia("(hover: hover)").matches;

            $(".productsCarousel").each(function () {

                var $carousel = $(this);
                var $category = $carousel.closest(".home-product-category");
                var $progress = $category.find(".carousel-progress");
                var bar = $progress.find(".carousel-progress-bar")[0];

                var hovering = false;

                function getOwl() {
                    return $carousel.data("owlCarousel");
                }

                // آخرین جایگاهی که carousel می‌تواند برود (۰ یا کمتر = چیزی برای اسکرول نیست)
                function getMax(owl) {
                    return typeof owl.maximumItem === "number"
                        ? owl.maximumItem
                        : owl.itemsAmount - owl.options.items;
                }

                function getCurrent(owl) {
                    return typeof owl.currentItem === "number"
                        ? owl.currentItem
                        : owl.owl.currentItem;
                }

                function applyPause() {
                    if (!bar) return;
                    bar.classList.toggle("is-paused", hovering || document.hidden);
                }

                // نوار را از صفر شروع می‌کند
                function startProgress() {
                    var owl = getOwl();
                    if (!owl || !bar) return;

                    var canScroll = getMax(owl) > 0 && !reduceMotion;

                    $progress.toggleClass("is-idle", !canScroll);
                    bar.classList.remove("is-running");

                    if (!canScroll) return;

                    void bar.offsetWidth; // ری‌استارت انیمیشن CSS
                    bar.style.animationDuration = AUTO_SLIDE_MS + "ms";
                    bar.classList.add("is-running");
                    applyPause();
                }

                $carousel.owlCarousel({
                    items: 4,

                    navigation: true,
                    navigationText: ["‹", "›"],

                    pagination: false,
                    autoPlay: false,          // حرکت خودکار را نوار پیشرفت کنترل می‌کند

                    responsive: true,
                    itemsDesktop: [1199, 3],
                    itemsDesktopSmall: [979, 2],
                    itemsTablet: [768, 2],
                    itemsMobile: [479, 1],

                    slideSpeed: 400,

                    // بعد از هر جابه‌جایی (خودکار، دکمه‌ها یا درگ) نوار از نو شروع می‌شود
                    afterAction: startProgress
                });

                if (!bar) return;

                // وقتی نوار پر شد: اسلاید بعدی، و اگر به آخر رسیده بود برگرد به اول
                bar.addEventListener("animationend", function () {
                    var owl = getOwl();
                    if (!owl) return;

                    if (getCurrent(owl) >= getMax(owl)) {
                        owl.goTo(0);
                    } else {
                        owl.next();
                    }

                    startProgress();
                });

                // توقف هنگام hover (فقط دستگاه‌هایی که ماوس دارند)
                if (canHover) {
                    $category.on("mouseenter focusin", function () {
                        hovering = true;
                        applyPause();
                    });

                    $category.on("mouseleave focusout", function () {
                        hovering = false;
                        applyPause();
                    });
                }

                // توقف وقتی تب مرورگر در پس‌زمینه است
                document.addEventListener("visibilitychange", applyPause);

                startProgress();
            });
        });
    </script>
}
