@{
    ViewData["Title"] = "درباره ما";
}

<!-- About Hero -->
<section class="about-hero">

    <div class="about-hero-content">

        <span class="about-badge">
            تجهیزات تاجیک
        </span>

        <h1>
            درباره تجهیزات تاجیک
        </h1>

        <p>
            همراه مطمئن شما در تأمین تجهیزات صنعتی،
            رستورانی، فست‌فود و هتلی
        </p>

    </div>

</section>


<!-- Introduction -->
<section class="about-introduction">

    <div class="about-introduction-content">

        <div class="about-section-title">
            <span>درباره ما</span>
            <h2>تجهیزات تاجیک؛ کیفیت، اعتماد و تخصص</h2>
        </div>

        <p>
            مجموعه تجهیزات تاجیک با هدف ارائه تجهیزات باکیفیت و قابل اعتماد
            برای کسب‌وکارهای مختلف فعالیت می‌کند. ما تلاش می‌کنیم با ارائه
            محصولات استاندارد، خدمات مناسب و پشتیبانی تخصصی، تجربه‌ای مطمئن
            برای مشتریان خود ایجاد کنیم.
        </p>

        <p>
            از رستوران‌ها و فست‌فودها گرفته تا هتل‌ها و مجموعه‌های صنعتی،
            هدف ما این است که نیاز مشتریان را به شکلی حرفه‌ای و قابل اعتماد
            پاسخ دهیم.
        </p>

    </div>

</section>


<!-- Our Values -->
<section class="about-values">

    <div class="about-section-title center">
        <span>ارزش‌های ما</span>
        <h2>چرا تجهیزات تاجیک؟</h2>
    </div>


    <div class="about-values-grid">

        <div class="about-value-card">

            <div class="about-value-icon">
                <i class="fa fa-check-circle"></i>
            </div>

            <h3>کیفیت محصولات</h3>

            <p>
                تلاش می‌کنیم محصولاتی با کیفیت مناسب و استانداردهای قابل
                اعتماد در اختیار مشتریان قرار دهیم.
            </p>

        </div>


        <div class="about-value-card">

            <div class="about-value-icon">
                <i class="fa fa-users"></i>
            </div>

            <h3>پشتیبانی تخصصی</h3>

            <p>
                در کنار فروش محصول، پاسخگویی و راهنمایی مشتریان برای ما
                اهمیت زیادی دارد.
            </p>

        </div>


        <div class="about-value-card">

            <div class="about-value-icon">
                <i class="fa fa-line-chart"></i>
            </div>

            <h3>تجربه و تخصص</h3>

            <p>
                با استفاده از دانش و تجربه تخصصی، تلاش می‌کنیم راهکارهای
                مناسب‌تری برای نیازهای مشتریان ارائه کنیم.
            </p>

        </div>


        <div class="about-value-card">

            <div class="about-value-icon">
                <i class="fa fa-handshake-o"></i>
            </div>

            <h3>اعتماد مشتری</h3>

            <p>
                رضایت و اعتماد مشتریان برای ما اهمیت ویژه‌ای دارد و پایه
                اصلی فعالیت مجموعه تجهیزات تاجیک است.
            </p>

        </div>

    </div>

</section>


<!-- Mission -->
<section class="about-mission">

    <div class="about-mission-content">

        <div class="about-mission-text">

            <span class="about-small-title">
                مأموریت ما
            </span>

            <h2>
                ساختن یک تجربه مطمئن برای مشتری
            </h2>

            <p>
                مأموریت ما تنها فروش تجهیزات نیست. ما می‌خواهیم در انتخاب
                محصول مناسب، تأمین تجهیزات و ارائه خدمات، در کنار مشتریان
                خود باشیم.
            </p>

            <p>
                به همین دلیل تلاش می‌کنیم کیفیت، قیمت مناسب و پشتیبانی
                حرفه‌ای را در کنار یکدیگر ارائه کنیم.
            </p>

        </div>


        <div class="about-mission-list">

            <div>
                <i class="fa fa-star"></i>
                <span>محصولات با کیفیت</span>
            </div>

            <div>
                <i class="fa fa-cogs"></i>
                <span>تجهیزات حرفه‌ای</span>
            </div>

            <div>
                <i class="fa fa-headphones"></i>
                <span>پشتیبانی مشتریان</span>
            </div>

            <div>
                <i class="fa fa-thumbs-up"></i>
                <span>رضایت مشتری</span>
            </div>

        </div>

    </div>

</section>


<!-- CTA -->
<section class="about-cta">

    <div>

        <h2>
            آماده همکاری با شما هستیم
        </h2>

        <p>
            برای مشاهده محصولات و تجهیزات موجود، از فروشگاه ما دیدن کنید.
        </p>

        <a asp-controller="Product"
           asp-action="Index"
           class="about-cta-btn">

            مشاهده محصولات

            <i class="fa fa-arrow-left"></i>

        </a>

    </div>

</section>