@using DataAccess.Models
@model Product

@{
    ViewData["Title"] = Model.ProductName;

    var hasStock = Model.StockQuantity > 0;
}

<input id="productId"
       type="hidden"
       value="@Model.ProductId" />

<main class="product-page">

    <!-- =====================================================
         Breadcrumb
         ===================================================== -->

    <nav class="product-breadcrumb"
         aria-label="مسیر صفحه">

        <a asp-controller="Home"
           asp-action="Index">
            صفحه اصلی
        </a>

        <i class="fa fa-angle-left"></i>

        <a asp-controller="Product"
           asp-action="ProductList">
            محصولات
        </a>

        <i class="fa fa-angle-left"></i>

        <span>
            @Model.ProductName
        </span>

    </nav>


    <!-- =====================================================
         Product Details
         ===================================================== -->

    <section class="product-main">

        <!-- =================================================
             Product Image
             ================================================= -->

        <div class="product-gallery">

            <div class="product-image-card">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="/api/FileUpload/GetFile?filename=@Uri.EscapeDataString(Model.ImageUrl)"
                         alt="@Model.ProductName"
                         class="product-main-image"
                         width="800"
                         height="800"
                         fetchpriority="high" />
                }
                else
                {
                    <div class="product-image-empty">

                        <i class="fa fa-image"></i>

                        <span>
                            تصویری برای این محصول ثبت نشده است.
                        </span>

                    </div>
                }

            </div>

        </div>


        <!-- =================================================
             Product Information
             ================================================= -->

        <div class="product-information">

            <div class="product-heading">

                <span class="product-label">
                    محصول
                </span>

                <h1>
                    @Model.ProductName
                </h1>

            </div>


            <!-- Description -->
            @if (!string.IsNullOrWhiteSpace(Model.ProductDescription))
            {
                <div class="product-description">

                    <h2>
                        توضیحات محصول
                    </h2>

                    <p>
                        @Model.ProductDescription
                    </p>

                </div>
            }


            <!-- Product Summary -->

            <div class="product-summary">

                <div class="product-summary-item">

                    <span>
                        وضعیت
                    </span>

                    @if (hasStock)
                    {
                        <strong class="product-stock available">
                            <i class="fa fa-check-circle"></i>
                            موجود
                        </strong>
                    }
                    else
                    {
                        <strong class="product-stock unavailable">
                            <i class="fa fa-times-circle"></i>
                            ناموجود
                        </strong>
                    }

                </div>


                <div class="product-summary-item">

                    <span>
                        موجودی
                    </span>

                    <strong>
                        @Model.StockQuantity.ToString("N0")
                        عدد
                    </strong>

                </div>

            </div>


            <!-- Purchase Box -->

            <div class="purchase-box">

                <div class="purchase-price">

                    <span>
                        قیمت
                    </span>

                    <strong id="basePriceShow">
                        @Model.Price.ToString("N0")
                        تومان
                    </strong>

                </div>


                <input id="stockQuantity"
                       type="hidden"
                       value="@Model.StockQuantity" />

                <input id="basePrice"
                       type="hidden"
                       value="@Model.Price" />


                @if (hasStock)
                {
                    <div class="purchase-controls">

                        <div class="quantity-control">

                            <label for="countInput">
                                تعداد
                            </label>

                            <input id="countInput"
                                   type="number"
                                   min="1"
                                   max="@Model.StockQuantity"
                                   value="1"
                                   class="product-quantity-input"
                                   inputmode="numeric" />

                        </div>


                        <span id="stockMessage"
                              class="product-stock-message">

                            موجودی انبار:
                            @Model.StockQuantity.ToString("N0")
                            عدد

                        </span>

                    </div>


                    <button type="button"
                            onclick="AddToBasket()"
                            class="product-add-btn">

                        <i class="fa fa-shopping-cart"></i>

                        افزودن به سبد خرید

                    </button>
                }
                else
                {
                    <div class="out-of-stock-message">

                        <i class="fa fa-exclamation-circle"></i>

                        <span>
                            این محصول در حال حاضر موجود نیست.
                        </span>

                    </div>


                    <button type="button"
                            class="product-add-btn disabled"
                            disabled>

                        <i class="fa fa-shopping-cart"></i>

                        محصول ناموجود است

                    </button>
                }

            </div>

        </div>

    </section>


    <!-- =====================================================
         Comments
         ===================================================== -->

    <section class="comments-section">

        <div class="comments-header">

            <div>

                <span class="comments-eyebrow">
                    تجربه کاربران
                </span>

                <h2 class="comments-title">
                    نظرات کاربران
                </h2>

            </div>


            <span class="comments-count-badge">

                <i class="fa fa-comments"></i>

                @Model.Comments.Count
                نظر

            </span>

        </div>


        <!-- Comment Form -->

        <div class="comment-form-card">

            <div class="comment-form-header">

                <h3>
                    نظر خود را با ما به اشتراک بگذارید
                </h3>

                <p>
                    نظر شما می‌تواند به دیگر کاربران در انتخاب محصول کمک کند.
                </p>

            </div>


            <form asp-action="AddProductComment"
                  asp-controller="Product"
                  method="post"
                  class="comment-form">

                @Html.AntiForgeryToken()


                <label for="commentText">
                    متن نظر
                </label>


                <textarea id="commentText"
                          name="Text"
                          rows="4"
                          maxlength="500"
                          placeholder="نظر خود را درباره این محصول بنویسید..."
                          required></textarea>


                <div class="comment-form-footer">

                    <span>
                        حداکثر ۵۰۰ کاراکتر
                    </span>


                    <button type="button"
                            onclick="addComment()"
                            class="btn-submit">

                        <i class="fa fa-paper-plane"></i>

                        ثبت نظر

                    </button>

                </div>

            </form>

        </div>


        <!-- Comments List -->
        @if (Model.Comments != null &&
        Model.Comments.Any())
        {
            <div class="comments-list">

                @foreach (var item in Model.Comments)
                {
                    <article class="comment-item">

                        <div class="comment-header">

                            <div class="comment-user">

                                <div class="comment-avatar">
                                    <i class="fa fa-user"></i>
                                </div>

                                <strong>
                                    @(item.User?.FullName ?? "کاربر")
                                </strong>

                            </div>


                            <time class="comment-date">

                                <i class="fa fa-clock-o"></i>

                                @item.Created.ToString(
                                         "yyyy/MM/dd - HH:mm")

                            </time>

                        </div>


                        <div class="comment-body">

                            <p>
                                @item.Text
                            </p>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="comments-empty">

                <div class="comments-empty-icon">
                    <i class="fa fa-comments-o"></i>
                </div>

                <h3>
                    هنوز نظری ثبت نشده است
                </h3>

                <p>
                    اولین نفری باشید که درباره این محصول نظر می‌دهد.
                </p>

            </div>
        }

    </section>

</main>