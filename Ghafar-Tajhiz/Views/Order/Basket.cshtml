@using DataAccess.Models
@model IReadOnlyList<BasketItem>

@{
    ViewData["Title"] = "سبد خرید";

    var totalPrice = Model.Sum(item =>
        item.Qty * item.UnitPrice);
}

<div class="cart-container">

    <h1 class="cart-header">
        سبد خرید شما
    </h1>

    @if (!Model.Any())
    {
        <div class="empty-cart">

            <p>
                سبد خرید شما خالی است
            </p>

            <a asp-controller="Product"
               asp-action="ProductList"
               class="btnProduct">
                ادامه خرید
            </a>

        </div>
    }
    else
    {
        <table class="cart-table">

            <thead>
                <tr>
                    <th>محصول</th>
                    <th>قیمت واحد</th>
                    <th>تعداد</th>
                    <th>جمع</th>
                    <th>حذف</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    var itemTotal =
                    item.Qty * item.UnitPrice;

                    <tr id="Basket_@item.BasketItemId">

                        <td>
                            <div style="display:flex;align-items:center;">

                                @if (!string.IsNullOrWhiteSpace(
                               item.Product?.ImageUrl))
                                {
                                    <img src="/api/FileUpload/GetFile?filename=@Uri.EscapeDataString(item.Product.ImageUrl)"
                                         alt="@item.Product.ProductName"
                                         class="cart-item-image"
                                         loading="lazy" />
                                }

                                <span style="margin-right:15px;">
                                    @item.Product?.ProductName
                                </span>

                            </div>
                        </td>

                        <td>
                            @item.UnitPrice.ToString("N0")
                            تومان
                        </td>

                        <td>
                            <div class="quantity-control">
                                @item.Qty
                            </div>
                        </td>

                        <td>
                            <strong>
                                @itemTotal.ToString("N0")
                                تومان
                            </strong>
                        </td>

                        <td>
                            <button type="button"
                                    onclick="RemoveBasketItem(@item.BasketItemId)"
                                    class="remove-btn">
                                حذف
                            </button>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <form asp-action="Pay"
              asp-controller="Order"
              method="post"
              id="payForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="cart-summary">

                <div class="summary-row">

                    <textarea id="address"
                              name="Address"
                              style="width:stretch;direction:rtl;height:100px"
                              class="text-opacity-100"
                              placeholder="آدرس..."></textarea>

                </div>

                <div class="summary-row">

                    <input id="mobile"
                           name="Mobile"
                           style="width:stretch;height:50px"
                           type="text"
                           inputmode="numeric"
                           placeholder="09xxxxxxxxx" />

                </div>

                <div class="summary-row">

                    <span>
                        مبلغ نهایی:
                    </span>

                    <span>
                        @totalPrice.ToString("N0")
                        <strong>تومان</strong>
                    </span>

                </div>

                <button type="submit"
                        class="checkout-btn"
                        onclick="return validateCheckOutForm()">
                    پرداخت و تکمیل سفارش
                </button>

            </div>

        </form>
    }

</div>