@model Ghafar_Tajhiz.Models.LoginViewModel

@{
    ViewData["Title"] = "ورود";
}

<div class="register-container">
    <div class="register-card">

        <div class="register-header">
            <h3>ورود به حساب</h3>
        </div>

        <div class="register-body">

            <form asp-action="Login"
                  asp-controller="Account"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber"
                           class="form-label">
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="09xxxxxxxxx"
                           dir="ltr"
                           autocomplete="tel" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password"
                           class="form-label">
                    </label>

                    <div class="password-wrapper">
                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               id="passwordInput"
                               autocomplete="current-password"
                               dir="ltr" />

                        <button type="button"
                                class="toggle-password"
                                id="togglePassword"
                                aria-label="نمایش رمز عبور">
                        </button>
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label class="terms">
                        <input asp-for="RememberMe"
                               type="checkbox" />

                        <span>
                            مرا به یاد بسپار
                        </span>
                    </label>
                </div>

                <button type="submit"
                        class="btn-register">
                    ورود
                </button>

                <div class="login-link">
                    حساب کاربری ندارید؟
                    <a asp-action="Register"
                       asp-controller="Account">
                        ثبت نام
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>