@model ErrorViewModel

@{
    ViewData["Title"] = "خطا";
}

<div class="text-center">

    <h1 class="text-danger">
        خطایی رخ داده است.
    </h1>

    <p>
        هنگام پردازش درخواست شما مشکلی رخ داد.
    </p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong>
            <code>@Model.RequestId</code>
        </p>
    }

</div>