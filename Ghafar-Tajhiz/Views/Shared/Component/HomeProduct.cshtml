@using Ghafar_Tajhiz.ViewModels
@model HomeProductsViewModel

<div class="home-products">

    @foreach (var category in Model.Categories)
    {
        if (category.Products.Any())
        {
            <section class="home-product-category">

                <div class="home-products-heading">
                    <h2>@category.CategoryName</h2>
                </div>

                @* نوار پیشرفت: وقتی پر شد، اسلاید بعدی نمایش داده می‌شود *@
                <div class="carousel-progress" aria-hidden="true">
                    <span class="carousel-progress-bar"></span>
                </div>

                <div class="owl-carousel owl-theme productsCarousel">

                    @foreach (var item in category.Products)
                    {
                        <div class="productsItems">

                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img class="productsImage"
                                     src="/api/FileUpload/GetFile?filename=@Uri.EscapeDataString(item.ImageUrl)"
                                     alt="@item.ProductName"
                                     loading="lazy" />
                            }

                            <div class="productsInfo">

                                <div class="productsInfoHeader">
                                    <h5>@item.ProductName</h5>

                                    <button type="button"
                                            class="openModal"
                                            data-product-id="@item.ProductId"
                                            aria-label="مشاهده اطلاعات محصول">
                                        <i class="infoBtn fa fa-info-circle"></i>
                                    </button>
                                </div>

                                <p>
                                    @item.Price.ToString("N0") تومان
                                </p>

                                <a asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-id="@item.ProductId"
                                   class="btnProduct">
                                    مشاهده محصول
                                </a>

                            </div>

                        </div>
                    }

                </div>

            </section>
        }
    }

</div>
