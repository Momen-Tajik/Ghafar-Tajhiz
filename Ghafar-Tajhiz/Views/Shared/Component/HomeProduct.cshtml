@using DataAccess.Models
@model IReadOnlyList<Product>

<div class="productsContainer">
    @foreach (var item in Model)
    {
        <div class="productsItems">

            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
            {
                <img class="productsImage"
                     src="/api/FileUpload/GetFile?filename=@Uri.EscapeDataString(item.ImageUrl)"
                     alt="@item.ProductName"
                     loading="lazy" />
            }

            <div class="productsInfo">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <h5>@item.ProductName</h5>

                    <button type="button"
                            class="openModal"
                            data-product-id="@item.ProductId"
                            aria-label="مشاهده اطلاعات محصول">
                        <i class="infoBtn fa fa-info-circle"></i>
                    </button>
                </div>

                <p>@item.Price.ToString("N0") تومان</p>

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-id="@item.ProductId"
                   class="btnProduct">
                    مشاهده محصول
                </a>
            </div>
        </div>
    }
</div>