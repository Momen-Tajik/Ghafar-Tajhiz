@using BusinessLogic.ProfileServices.Models
@using DataAccess.Enums
@model UserProfileViewModel

@{
    ViewData["Title"] = "پروفایل";
}

<div class="user-dashboard">

    <aside class="user-info">

        <div class="user-card">

            <h3>اطلاعات کاربر</h3>

            <p>
                <strong>نام کاربری:</strong>
                @Model.UserName
            </p>

            <p>
                <strong>شماره موبایل:</strong>
                @(Model.MobileNumber ?? "ثبت نشده")
            </p>

            <p>
                <strong>آدرس:</strong>
                @(string.IsNullOrWhiteSpace(Model.Address)
                    ? "ثبت نشده"
                    : Model.Address)
            </p>

        </div>

    </aside>


    <section class="user-orders">

        <!-- فیلتر -->
        <form method="get">

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="جستجوی سفارش..." />

            <select name="status">

                <option value="">
                    همه
                </option>

                <option value="PendingPayment"
                        selected="@(Model.Status == BasketStatus.PendingPayment ? "selected" : null)">
                    در انتظار پرداخت
                </option>

                <option value="AwaitingPaymentVerification"
                        selected="@(Model.Status == BasketStatus.AwaitingPaymentVerification ? "selected" : null)">
                    در انتظار بررسی پرداخت
                </option>

                <option value="PaymentApproved"
                        selected="@(Model.Status == BasketStatus.PaymentApproved ? "selected" : null)">
                    پرداخت تأیید شد
                </option>

                <option value="PaymentRejected"
                        selected="@(Model.Status == BasketStatus.PaymentRejected ? "selected" : null)">
                    پرداخت رد شد
                </option>

                <option value="Shipped"
                        selected="@(Model.Status == BasketStatus.Shipped ? "selected" : null)">
                    ارسال شده
                </option>

                <option value="Cancelled"
                        selected="@(Model.Status == BasketStatus.Cancelled ? "selected" : null)">
                    لغو شده
                </option>

            </select>


            <!-- مرتب سازی -->

            <select name="sort">

                <option value="paiddate"
                        selected="@(Model.Sort == "paiddate" ? "selected" : null)">
                    جدیدترین
                </option>

                <option value="oldest"
                        selected="@(Model.Sort == "oldest" ? "selected" : null)">
                    قدیمی‌ترین
                </option>

                <option value="status"
                        selected="@(Model.Sort == "status" ? "selected" : null)">
                    وضعیت
                </option>

            </select>


            <button type="submit">
                اعمال فیلتر
            </button>

        </form>


        @if (!Model.Orders.Any())
        {
            <div class="products-empty">
                سفارشی وجود ندارد
            </div>
        }
        else
        {
            foreach (var order in Model.Orders)
            {
                <div class="order-card">

                    <div class="order-header">

                        <span>
                            شماره سفارش:
                            @order.BasketId
                        </span>


                        @switch (order.Status)
                        {
                            case BasketStatus.PendingPayment:

                                <span class="order-status pending">
                                    در انتظار پرداخت
                                </span>

                                break;


                            case BasketStatus.AwaitingPaymentVerification:

                                <span class="order-status pending">
                                    در انتظار بررسی پرداخت
                                </span>

                                break;


                            case BasketStatus.PaymentApproved:

                                <span class="order-status paid">
                                    پرداخت تأیید شد
                                </span>

                                break;


                            case BasketStatus.PaymentRejected:

                                <span class="order-status cancelled">
                                    پرداخت رد شد
                                </span>

                                break;


                            case BasketStatus.Shipped:

                                <span class="order-status shipped">
                                    ارسال شده
                                </span>

                                break;


                            case BasketStatus.Cancelled:

                                <span class="order-status cancelled">
                                    لغو شده
                                </span>

                                break;


                            default:

                                <span class="order-status">
                                    نامشخص
                                </span>

                                break;
                        }

                    </div>


                    <!-- اطلاعات سفارش -->

                    <div class="order-meta">

                        <span>
                            @(order.PaidDate.HasValue
                                ? order.PaidDate.Value.ToString("HH:mm - yyyy/MM/dd")
                                : "-")
                        </span>

                        <br />

                        <span>
                            @order.MobileNumber
                        </span>

                        <br />

                        <span>
                            @order.Address
                        </span>

                    </div>


                    <!-- محصولات -->

                    <div class="order-items">

                        @if (order.BasketItems.Any())
                        {
                            decimal orderTotal = 0;

                            foreach (var item in order.BasketItems)
                            {
                                var itemTotal = item.Qty * item.UnitPrice;

                                orderTotal += itemTotal;

                                <div class="order-item">

                                    <span class="product-name">
                                        @item.Product?.ProductName
                                    </span>

                                    <span class="price">
                                        قیمت واحد:
                                        @item.UnitPrice.ToString("N0")
                                        تومان
                                    </span>

                                    <span class="qty">
                                        @item.Qty عدد
                                    </span>

                                    <span class="price">
                                        جمع:
                                        @itemTotal.ToString("N0")
                                        تومان
                                    </span>

                                </div>
                            }


                            <!-- جمع کل -->

                            <div class="order-items">

                                <span class="total-price">
                                    جمع کل
                                </span>

                                <span class="total-price">
                                    @orderTotal.ToString("N0")
                                    تومان
                                </span>

                            </div>
                        }

                    </div>

                </div>
            }
        }

    </section>

</div>