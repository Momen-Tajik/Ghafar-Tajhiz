@using BusinessLogic.ProfileServices.Models
@using DataAccess.Enums
@model UserProfileViewModel

@{
    ViewData["Title"] = "پروفایل";
}

<div class="user-dashboard">

    <aside class="user-info">

        <div class="user-card">

            <h3>
                اطلاعات کاربر
            </h3>

            <p>
                <strong>نام کاربری:</strong>
                @Model.UserName
            </p>

            <p>
                <strong>شماره موبایل:</strong>
                @(Model.MobileNumber ?? "ثبت نشده")
            </p>

            <p>
                <strong>آدرس:</strong>
                @(string.IsNullOrWhiteSpace(Model.Address)
                    ? "ثبت نشده"
                    : Model.Address)
            </p>

        </div>

    </aside>

    <section class="user-orders">

        <form method="get">

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="جستجوی سفارش..." />

            <select name="status">

                <option value="">
                    همه
                </option>

                <option value="Paid"
                        selected="@(Model.Status == BasketStatus.Paid ? "selected" : null)">
                    پرداخت شده
                </option>

                <option value="Shipped"
                        selected="@(Model.Status == BasketStatus.Shipped ? "selected" : null)">
                    ارسال شده
                </option>

                <option value="Cancelled"
                        selected="@(Model.Status == BasketStatus.Cancelled ? "selected" : null)">
                    لغو شده
                </option>

            </select>

            <select name="sort">

                <option value="paiddate"
                        selected="@(Model.Sort == "paiddate" ? "selected" : null)">
                    جدیدترین
                </option>

                <option value="oldest"
                        selected="@(Model.Sort == "oldest" ? "selected" : null)">
                    قدیمی‌ترین
                </option>

                <option value="status"
                        selected="@(Model.Sort == "status" ? "selected" : null)">
                    وضعیت
                </option>

            </select>

            <button type="submit">
                اعمال فیلتر
            </button>

        </form>

        @if (!Model.Orders.Any())
        {
            <div class="products-empty">
                سفارشی وجود ندارد
            </div>
        }
        else
        {
            foreach (var order in Model.Orders)
            {
                <div class="order-card">

                    <div class="order-header">

                        <span>
                            شماره سفارش:
                            @order.BasketId
                        </span>

                        @switch (order.Status)
                        {
                            case BasketStatus.Paid:
                                <span class="order-status paid">
                                    پرداخت شده
                                </span>
                                break;

                            case BasketStatus.Shipped:
                                <span class="order-status shipped">
                                    ارسال شده
                                </span>
                                break;

                            case BasketStatus.Cancelled:
                                <span class="order-status cancelled">
                                    لغو شده
                                </span>
                                break;

                            default:
                                <span class="order-status">
                                    در انتظار پرداخت
                                </span>
                                break;
                        }

                    </div>

                    <div class="order-meta">

                        <span>
                            @(order.PaidDate.HasValue
                                ? order.PaidDate.Value.ToString(
                                    "HH:mm - yyyy/MM/dd")
                                : "-")
                        </span>

                        <br />

                        <span>
                            @order.MobileNumber
                        </span>

                        <br />

                        <span>
                            @order.Address
                        </span>

                    </div>

                    <div class="order-items">

                        @if (order.BasketItems.Any())
                        {
                            foreach (var item in order.BasketItems)
                            {
                                var itemTotal =
                                    item.Qty * item.UnitPrice;

                                <div class="order-item">

                                    <span class="product-name">
                                        @item.Product?.ProductName
                                    </span>

                                    <span class="price">
                                        قیمت واحد:
                                        @item.UnitPrice.ToString("N0")
                                        تومان
                                    </span>

                                    <span class="qty">
                                        @item.Qty عدد
                                    </span>

                                    <span class="price">
                                        جمع:
                                        @itemTotal.ToString("N0")
                                        تومان
                                    </span>

                                </div>
                            }

                            
                                decimal orderTotal = 0;

                                foreach (var item in order.BasketItems)
                                {
                                    orderTotal += item.Qty * item.UnitPrice;
                                }
                            

                            <div class="order-items">

                                <span class="total-price">
                                    جمع کل
                                </span>

                                <span class="total-price">
                                    @orderTotal.ToString("N0")
                                    تومان
                                </span>

                            </div>
                        }

                    </div>

                </div>
            }
        }

    </section>

</div>